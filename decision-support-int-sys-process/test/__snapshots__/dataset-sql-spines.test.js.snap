// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`dataset SQL spines > line-items, order-value-hist, viewport-weekly, and clicks send the same SQL 1`] = `
{
  "clicks": [
    {
      "label": "clicks:page",
      "params": [
        "day",
        "hsr",
        "idsite",
        "idsitehsr",
        "w0",
        "w1",
      ],
      "sql": "WITH entry AS ( SELECT CAST(idvisit AS UInt64) AS idvisit FROM ( SELECT idvisit, toString(argMin(visit_entry_idaction_url, visit_first_action_time)) AS entry_hsr FROM default.udp_hsrce_visits WHERE idsite = {idsite:UInt32} AND server_date BETWEEN {w0:Date} AND {w1:Date} GROUP BY idvisit ) WHERE entry_hsr = {hsr:String} ), clicks AS ( SELECT idvisit, idloghsr, idselector, idsite, idsitehsr, server_date, toDateTime(concat(date, ' ', hour, ':00:00')) AS server_time, meta1, a_x, a_y, time_since_load FROM default.udp_clicksce_clicks WHERE idsite = {idsite:UInt32} AND idsitehsr = {idsitehsr:UInt64} AND server_date = {day:Date} ) SELECT toString(c.idvisit) AS idvisit, toString(c.idloghsr) AS idloghsr, c.idselector AS selector, toMonday(c.server_date) AS week, toString(c.server_date) AS date, toString(c.server_time) AS server_time, c.meta1 AS meta1, c.a_x AS x, c.a_y AS y, ifNull(c.time_since_load, -1) AS time_since_load FROM clicks c INNER JOIN entry e ON e.idvisit = CAST(c.idvisit AS UInt64)",
